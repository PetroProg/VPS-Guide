# ==============================================================================
# VPS SSH Configuration for GitHub (~/.ssh/config on the VPS)
# Permissions required: chmod 700 ~/.ssh && chmod 600 ~/.ssh/config
# Use a dedicated read-only Deploy Key (never copy your personal key to a VPS).
# ==============================================================================

Host github.com
    HostName        github.com
    User            git
    IdentityFile    ~/.ssh/id_ed25519_github_deploy
    IdentitiesOnly  yes
